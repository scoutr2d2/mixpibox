#!/usr/bin/env bash
# Starter für controller/rsi.py — wählt automatisch den richtigen Python:
# das lokale .venv (falls setup-controller.sh eins angelegt hat), sonst python3.
# So ist es egal, ob die Abhängigkeiten im System oder im venv liegen.
[ -n "${BASH_VERSION:-}" ] || exec bash "$0" "$@"
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PY="$HERE/.venv/bin/python"
[ -x "$PY" ] || PY="$(command -v python3 || command -v python)"
exec "$PY" "$HERE/controller/rsi.py" "$@"
